VITE_SUPABASE_URL=your_supabase_project_url_here
# Use a Supabase publishable key, or set the legacy anon key below instead.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required client-side admin navigation gate. All VITE_* values are public.
# Supabase Auth verifies the password; database access must be protected by RLS.
VITE_ADMIN_EMAIL=
