VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Login is temporarily disabled for development, including deployed builds.
# Set true and rebuild to require login again.
VITE_AUTH_ENABLED=false

# Used when VITE_AUTH_ENABLED=true by the existing login flow. Every VITE_* value is public in the browser.
# Never commit real values. See docs/audit-struktur.md for the auth follow-up.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
